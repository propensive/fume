//| mill-version: 1.1.5
//| mill-jvm-version: temurin:25
//| mill-jvm-opts: ["-Xss16m", "-XX:NonProfiledCodeHeapSize=250m", "-XX:ReservedCodeCacheSize=500m"]
//| mvnDeps: ["dev.propensive:crux-mill:0.1.1"]

package build

import mill.*
import scalalib.*
// `PomSettings`, `License`, `Developer`, `VersionControl`, `PublishModule` — the Maven publishing
// vocabulary, imported exactly as the Soundness build does (`scalalib.publish.*`).
import publish.*
// crux (propensive/crux): the pinned releases on GitHub, read directly as Coursier repositories.
import crux.*

object settings:
  // The compiler is the propensive Scala fork, Proscala, at this version: pinned in `deps` below
  // like the libraries and resolved from its GitHub release by crux, which also forces every
  // `org.scala-lang` artifact to it, since the pinned libraries name the release each was built
  // with. The fork stays TASTy-compatible across its patch releases, which is what every such
  // pin assumes.
  val scalaVersion = "3.10.0-pro-1.0.2"

  // This build's version. A release's version is declared once, by its tag: the release
  // (release.sh in propensive/.github) and a snapshot (snapshot.sh) both name it in
  // `FUME_RELEASE_VERSION`. Any other build is the version after the latest release reachable
  // from HEAD — its patch version plus one, which sorts after that release and before whichever
  // follows it — or `0.0.1` where no release tag is reachable, as in CI's shallow checkout.
  // Called from `Task.Input`s, so the environment and the tags are read on every invocation.
  def version(env: Map[String, String]): String =
    env.get("FUME_RELEASE_VERSION").filter(_.nonEmpty).getOrElse(nextVersion)

  def nextVersion: String =
    val root = mill.api.BuildCtx.workspaceRoot

    val latest: Option[String] =
      scala.util.Try:
        os.proc("git", "describe", "--tags", "--abbrev=0", "--match", "[0-9]*.[0-9]*.[0-9]*")
        . call(cwd = root, stderr = os.Pipe).out.text().trim
      . toOption

    def numeric(part: String): Boolean = part.nonEmpty && part.forall(_.isDigit)

    latest.collect:
      case s"$major.$minor.$patch" if Seq(major, minor, patch).forall(numeric) =>
        s"$major.$minor.${patch.toInt + 1}"
    . getOrElse("0.0.1")

  // What a build of fume identifies itself as, written into the client jar as
  // `META-INF/pyrocosm/fume/version` for `pyrocosm-cli` to read (`fume about`,
  // `fume --version`): the version a release or snapshot is published as, when
  // `FUME_RELEASE_VERSION` names it (`make snapshot` and the release both set it);
  // otherwise the next version (`nextVersion`) with the filtered tree hash of HEAD — the identity
  // `make snapshot` would give this commit — and `-dirty` if the working tree has changes
  // that no commit records. Called from a `Task.Input`, so that HEAD is consulted on every
  // invocation.
  def buildVersion(env: Map[String, String]): String =
    env.get("FUME_RELEASE_VERSION").filter(_.nonEmpty).getOrElse:
      val root = mill.api.BuildCtx.workspaceRoot

      val tree: String =
        scala.util.Try:
          os.proc("./etc/shared", "filtered_tree.py", "HEAD").call(cwd = root).out.text().trim
        . getOrElse(os.proc("git", "rev-parse", "HEAD^{tree}").call(cwd = root).out.text().trim)

      val dirty: Boolean =
        os.proc("git", "status", "--porcelain").call(cwd = root).out.text().trim.nonEmpty
      s"$nextVersion-${tree.take(12)}${if dirty then "-dirty" else ""}"

  val scalaOptions = Seq(
    // The fork's opt-in behaviours, enabled by name, exactly as the Soundness build enables
    // them (fume compiles the same idioms from the same TASTy): every capture-checking
    // repair, spreadable varargs, given-prefix sealing, diagnostic givens, and JSR-45 source
    // maps (formerly `-Xjsr45` — fume's own code is heavily inlined Soundness code, so
    // without the maps a frame in one of fume's classes resolves to a synthetic line).
    "-Zalias-captures",
    "-Zdiagnostic-givens",
    "-Zgiven-prefixes",
    "-Zinline-source-maps",
    "-Zopaque-mutability",
    "-Zpure-iarrays",
    "-Zfrozen-pure",
    "-Zretains-bounds",
    "-Zretains-skolems",
    "-Zspreadable-varargs",
    "-Zunboxed-pure-types",
    "-Zunion-captures",
    "-experimental",
    "-new-syntax",
    "-feature",
    "-preview",
    "-deprecation",
    "-Wunused:imports",
    "-Wimplausible-patterns",
    "-Xmax-inlines", "32",
    "-Yno-flexible-types",
    "-Yexplicit-nulls",
    "-Ycheck-all-patmat",
    "-language:experimental.modularity",
    "-language:experimental.dependent",
    "-language:experimental.relaxedLambdaSyntax",
    "-language:experimental.genericNumberLiterals",
    "-language:experimental.into",
    "-language:experimental.erasedDefinitions",
    "-language:implicitConversions",
    "-language:experimental.saferExceptions",
    "-language:experimental.strictEqualityPatternMatching",
    "-language:experimental.subCases",
    "-language:experimental.multiSpreads",
    // Capture checking AND separation checking, matching Soundness's `settings.sep` (its
    // strictest rollout tier): the language flags are equivalent to per-file
    // `import language.experimental.captureChecking`/`.separationChecking`, so no source edits
    // are needed. The Soundness bundles fume reads were mostly built without capture checking,
    // which is fine in this direction (non-CC TASTy is readable from a CC compilation unit).
    "-Ycc-new",
    "-language:experimental.captureChecking",
    "-language:experimental.separationChecking"
  )

  // Fume's sources are written for the proscenium predef (the soundness house
  // predef), so the standalone build replicates `-Yno-predef -Yimports:…`.
  // `scala` is deliberately NOT imported (as of Soundness #1693): the blessed collections are
  // proscenium's opaque `List`/`Set`/`Map`/`Array`, and naming both packages would make every
  // such reference ambiguous. Stdlib collections must announce themselves with an explicit
  // `scala.`-qualified name or import, and cross the boundary through `proscenium.compat`.
  val predef = Seq("-Yno-predef", "-Yimports:java.lang,proscenium")

  // Soundness publishes COMPONENTS again (Soundness #1929): each tagged version is a GitHub
  // release whose assets are the individual component jars, and the bundles — including the
  // `dev.propensive:soundness` universal aggregate fume used to depend on — are no longer
  // published. Every released jar embeds its own POM and ivy.xml (`META-INF/maven/…`), and
  // `make sync-releases VERSION=X.Y.Z` in the Soundness repository installs a release into
  // `~/.ivy2/local` (Soundness #1933), from which coursier resolves these coordinates with no
  // repository configuration. Component jars carry no `_3` suffix, hence the single-colon
  // `mvn"…"`.
  //
  // These are fume's TOP-LEVEL components only: each jar's embedded POM names its own
  // dependencies, so the rest of the surface fume's `import soundness.*` touches arrives
  // transitively.
  def soundnessDeps(soundness: String, pyrocosm: String) = Seq(
    mvn"dev.propensive:aviation-core:$soundness",       // timespec literals (0.2*Second)
    mvn"dev.propensive:coaxial-jvm:$soundness",         // TLS sockets, through pyrocosm-remote
    mvn"dev.propensive:gastronomy-core:$soundness",     // classpath digests, through pyrocosm-remote
    mvn"dev.propensive:zeppelin-core:$soundness",       // bundling class directories into jars
    mvn"dev.propensive:burdock-core:$soundness",        // externalize + the repackager
    mvn"dev.propensive:digression-ansi:$soundness",     // stack-trace diagnostics
    mvn"dev.propensive:escapade-io:$soundness",         // Teletype ↔ Stdio writables
    mvn"dev.propensive:escritoire-core:$soundness",     // the board's tables
    mvn"dev.propensive:ethereal-core:$soundness",       // the daemon
    mvn"dev.propensive:eucalyptus-core:$soundness",     // logging.silentLogging
    mvn"dev.propensive:exoskeleton-completions:$soundness", // execute + tab-completion
    mvn"dev.propensive:exoskeleton-manpage:$soundness", // fume install's manpage
    mvn"dev.propensive:galilei-jvm:$soundness",         // filesystem + glob
    mvn"dev.propensive:guillotine-core:$soundness",     // sh"…" for forked suites
    mvn"dev.propensive:hellenism-jvm:$soundness",       // LocalClasspath, classloaders
    mvn"dev.propensive:iridescence-core:$soundness",    // the palette
    mvn"dev.propensive:jacinta-schema:$soundness",      // JSON codecs and schemas for the API
    mvn"dev.propensive:jacinta-time:$soundness",        // (with aviation's instants)
    mvn"dev.propensive:probably-cli:$soundness",        // Suite and its runner
    mvn"dev.propensive:probably-events:$soundness",     // the BinTEL event stream
    mvn"dev.propensive:sedentary-core:$soundness",      // benchmarks and stress tests
    mvn"dev.propensive:stratiform-core:$soundness",     // .pyrocosm/fume/config.tel
    mvn"dev.propensive:stratiform-time:$soundness",     // run.tel's timestamps
    mvn"dev.propensive:synesthesia-core:$soundness",    // the MCP server
    mvn"dev.propensive:scintillate-server:$soundness",  // which serves over HTTP
    mvn"dev.propensive:tasseomancy-core:$soundness",    // the dashboard's charts
    mvn"dev.propensive:tessellate-core:$soundness",     // Flow.wrap for report text
    mvn"dev.propensive:ultimatum-core:$soundness",      // the scrolling viewport
    mvn"dev.propensive:pyrocosm-model:$pyrocosm",       // the board's semantic model
    mvn"dev.propensive:pyrocosm-terminal:$pyrocosm",    // its terminal frontend,
    mvn"dev.propensive:pyrocosm-web:$pyrocosm",         // and its web frontend
    mvn"dev.propensive:pyrocosm-cli:$pyrocosm",         // the standard command line (Tool)
    mvn"dev.propensive:pyrocosm-bus:$pyrocosm",         // what a node of the swarm advertises
    mvn"dev.propensive:pyrocosm-swarm:$pyrocosm",       // the swarm, for the machines a run can go to
    mvn"dev.propensive:pyrocosm-remote:$pyrocosm")      // machines, the TLS peer, the channel, blobs

// The propensive libraries this build depends on, pinned in etc/refs (the format, the snapshot flow
// and the shared scripts are documented in propensive/.github): each is a release `X.Y.Z`, or a
// snapshot `X.Y.Z-<12 hex>` of an unreleased upstream build, published there by `make snapshot`.
// crux resolves each — and, transitively, what each was built against — from its GitHub release;
// nothing is installed locally. The Proscala pin is declared here rather than in etc/refs, which
// deps.py (propensive/.github) also reads and which does not yet know the form of a Proscala
// version. The file is read as a source, so editing it invalidates every resolution.
object deps extends CruxModule:
  def refsFiles = Task.Sources(mill.api.BuildCtx.workspaceRoot / "etc" / "refs")
  def declared = Seq(Pin("propensive/proscala", settings.scalaVersion))

  def soundness: T[String] = Task(version("soundness")())
  def pyrocosm: T[String] = Task(version("pyrocosm")())

// A module compiled with the pinned fork, against the pinned libraries.
trait Fork extends CruxScalaModule:
  def crux = deps

trait Project extends Module:
  def moduleDir = super.moduleDir / os.up / "src"

// Dependencies are typed `PublishModule*` (as in the Soundness build) so that `moduleDeps` can
// return `Seq[PublishModule]` — the type `SonatypeCentralPublishModule` requires of the modules that
// mix in `Publishing`. Fume's only inter-module dependency (`client`) is published, so this costs
// the unpublished modules (`launcher`, `test`) nothing.
trait Component(dependencies: PublishModule*) extends Fork:
  override def scalacOptions = settings.scalaOptions ++ settings.predef

  // The beneficence plugin writes `META-INF/givens/<typeclass>` and `META-INF/services/probably.Suite`
  // into every module that contributes an entry, so each is a *fragment* of a build-wide index rather
  // than a whole file. Mill's default assembly rules are last-one-wins, which silently truncates
  // them: fume's Soundness dependency arrives as eight bundle jars which collide on dozens of such
  // entries, and `beneficence` reads the index at runtime through `getResources`. Concatenate
  // instead, exactly as the Soundness build does (`mergeRules`). Every fragment ends with a newline,
  // so the empty separator is correct. `META-INF/services/probably.Suite` is also precisely the
  // index fume itself reads to discover suites on a user-supplied classpath.
  override def assemblyRules = super.assemblyRules ++ Seq(
    mill.javalib.Assembly.Rule.AppendPattern("META-INF/givens/.*"),
    mill.javalib.Assembly.Rule.AppendPattern("META-INF/services/.*"))
  def moduleId: String = moduleDir.last
  def moduleDeps: Seq[PublishModule] = dependencies
  def sources = Task.Sources(moduleDir)

// Mixed into the library module that is released to Maven Central (`client`) — the module the
// `launcher` then pulls back in as a published coordinate. Every setting mirrors the Soundness
// build (`soundness/build.mill`, `BaseScalaModule`): the same `dev.propensive` organization, URL,
// Apache-2.0 licence, GitHub SCM and developer, plus the empty `-javadoc.jar` that satisfies
// Central without generating real docs. `SonatypeCentralPublishModule` targets the Central Portal
// (central.sonatype.com), driven by the standard `MILL_SONATYPE_*`/`MILL_PGP_*` env vars at release.
trait Publishing extends Fork, SonatypeCentralPublishModule:
  // A `Task.Input` reading `Task.env`, not a plain value: `FUME_RELEASE_VERSION` is how a
  // release and `make snapshot` (release.sh and snapshot.sh in propensive/.github) drive the
  // version through a Mill daemon that is already running — the daemon freezes `sys.env` at its
  // own start, while `Task.env` is the environment of each `./mill` invocation. Without it, the
  // version is `settings.nextVersion`. The launcher resolves this module at this same version.
  def publishVersion = Task.Input:
    settings.version(Task.env)
  def artifactSuffix = Task("")

  def pomSettings = Task(PomSettings(
    description = "fume",
    organization = "dev.propensive",
    url = "https://soundness.dev/",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("propensive", "fume"),
    developers = Seq(Developer("propensive", "Jon Pretty", "https://github.com/propensive"))))

  override def docJar = Task:
    val jar = Task.dest / "empty.jar"
    val zos = new java.util.zip.ZipOutputStream(new java.io.FileOutputStream(jar.toIO))
    zos.close()
    PathRef(jar)

object fume extends Project:
  // The messages a controller and a worker exchange (`fume.Relay`) and their derived BinTEL
  // codec, ALONE in a module compiled without capture checking, as Probably keeps its event
  // codec in `probably-events`: stratiform's derived codecs expand to instances the capture
  // checker sees as fresh where a pure instance is required, so their derivation site cannot be
  // a checked module. Published as `dev.propensive:fume-relay`.
  object relay extends Component(), Publishing:
    def mvnDeps = Task(settings.soundnessDeps(deps.soundness(), deps.pyrocosm()))

    override def scalacOptions =
      (settings.scalaOptions ++ settings.predef).filterNot: option =>
        option == "-Ycc-new" || option.contains("captureChecking") || option.contains("separationChecking")

  // The run record every run is persisted as (`fume.RunRecord`), the JSON types the MCP server
  // serves (`fume.Api`) with their derived TEL and JSON codecs and JSON schemas, and the MCP
  // server itself (`fume.McpServer`), whose tools delegate to the client. Without capture
  // checking for the same reason as `relay`, twice over: the TEL codec of `run.tel` is derived
  // here, and so is the server's specification, whose generated code is not capture-clean
  // either. Published as `dev.propensive:fume-api`.
  object api extends Component(), Publishing:
    def mvnDeps = Task(settings.soundnessDeps(deps.soundness(), deps.pyrocosm()))

    override def scalacOptions =
      (settings.scalaOptions ++ settings.predef).filterNot: option =>
        option == "-Ycc-new" || option.contains("captureChecking") || option.contains("separationChecking")

  // All of fume's logic — subcommands, flags, dispatch and (later) the test-running machinery.
  // Published to Maven Central as `dev.propensive:fume-client`.
  object client extends Component(relay, api), Publishing:
    def mvnDeps = Task(settings.soundnessDeps(deps.soundness(), deps.pyrocosm()))

    // Fume's own version, as `fume about` and `fume --version` report it: see
    // `settings.buildVersion`.
    def buildVersion = Task.Input(settings.buildVersion(Task.env))

    // The static files the dashboard serves (`res/fume/*.svg`, the invokers' icons), as
    // pyrocosm's build maps `res/web`: the directory is the classpath root, so `res/fume/x.svg`
    // is the resource `fume/x.svg`.
    def assets = Task.Sources(mill.api.BuildCtx.workspaceRoot / "res")

    // The MCP server's documentation, `doc/mcp.md`, travels in the jar as `fume/mcp.md`, which
    // the server serves as the `fume://docs` resource.
    def documentation = Task.Source(mill.api.BuildCtx.workspaceRoot / "doc" / "mcp.md")

    override def resources = Task:
      val file = Task.dest / "META-INF" / "pyrocosm" / "fume" / "version"
      os.write.over(file, buildVersion() + "\n", createFolders = true)
      os.copy.over(documentation().path, Task.dest / "fume" / "mcp.md", createFolders = true)
      super.resources() ++ assets() ++ Seq(PathRef(Task.dest))

  // The invocation point, ALONE in its own module (`src/launcher/fume_launcher.scala` — just the
  // `object fume` whose `main` is `externalize(Client.run())`). It depends on `client` NOT as a Mill `moduleDep`
  // but as a PUBLISHED Maven coordinate, so coursier puts the byte-identical Central jar on the
  // compile classpath that `externalize` hashes; the repackager then externalizes it into an
  // on-demand download instead of inlining. Burdock is also named explicitly because the
  // `externalize` macro and the `soundness.repackage` main are compiled/run against it — it ships
  // in the `soundness-cli` bundle, and in no other.
  //
  // NOTE: this module can only be built AFTER `fume-client` is on Maven Central at
  // the version `client.publishVersion` gives, since coursier must resolve the real Central artifact (a local
  // `publishLocal` copy has different bytes and would be inlined, not externalized). Before the
  // first release, `make run` publishes locally and assembles against that instead.
  object launcher extends Component():
    def mvnDeps = Task:
      mvn"dev.propensive:fume-client:${client.publishVersion()}"
        +: settings.soundnessDeps(deps.soundness(), deps.pyrocosm())
    def finalMainClass = "fume.fume"
    // A clean zip (no executable shell preamble) so the Burdock repackager can read and rewrite the
    // assembled JAR.
    def prependShellScript = ""

  // A `Suite` is not a main class (Soundness #1963): the beneficence plugin writes the
  // `META-INF/services/probably.Suite` index a host reads to discover suites, so the plugin
  // must run on this module or `fume run -c` finds nothing. `fume.runTests` is a plain-`java`
  // entry point that drives `Tests.invoke` in-process, for `make test` and the shared CI.
  object test extends Component(client):
    def mvnDeps = Task(settings.soundnessDeps(deps.soundness(), deps.pyrocosm()))
    def scalacPluginMvnDeps = Task(Seq(mvn"dev.propensive:beneficence-plugin:${deps.soundness()}"))
    def finalMainClass = "fume.runTests"

// The release: the library modules' jars, each with its POM and ivy.xml embedded under
// `META-INF/maven/<group>/<artifactId>/`, named `<artifactId>-<version>.jar`, exactly as the
// Soundness and Pyrocosm builds stage theirs. A jar so staged is all a consumer needs: the shared
// sync script (propensive/.github) reconstructs the ivy2 layout coursier resolves from, which is
// how `make snapshot` publishes an unreleased build for a dependent repository to pin.
object release extends Module:
  def modules: Seq[PublishModule] = Seq(fume.relay, fume.api, fume.client)

  private def withDescriptors(source: os.Path, target: os.Path, entries: Seq[(String, os.Path)])
  :   Unit =
    val input = new java.util.zip.ZipFile(source.toIO)
    val output = new java.util.zip.ZipOutputStream(new java.io.FileOutputStream(target.toIO))
    try
      val existing = input.entries()
      while existing.hasMoreElements do
        val entry = existing.nextElement()
        output.putNextEntry(new java.util.zip.ZipEntry(entry.getName))
        if !entry.isDirectory then input.getInputStream(entry).transferTo(output)
        output.closeEntry()

      for (name, file) <- entries do
        output.putNextEntry(new java.util.zip.ZipEntry(name))
        output.write(os.read.bytes(file))
        output.closeEntry()
    finally
      output.close()
      input.close()

  // The ivy.xml published beside each jar as `<artifactId>-<version>.ivy.xml`: the metadata
  // Coursier reads when crux (propensive/crux) uses the release as an Ivy-pattern repository,
  // without the sources and javadoc publications. Mill declares those in the `compile`
  // configuration too, and the crux artifact pattern names the main jar for any publication
  // without a classifier, so left in place they would resolve to the jar itself.
  private def stripDescriptor(ivy: String): String =
    val artifact = """<artifact\b[^>]*?(?:/>|>\s*</artifact>)""".r
    val filtered = artifact.replaceAllIn(ivy, found =>
      if found.matched.contains("classifier=") || found.matched.matches("""(?s).*\btype="(src|doc)".*""")
      then "" else java.util.regex.Matcher.quoteReplacement(found.matched))
    filtered.linesIterator.filter(_.trim.nonEmpty).mkString("", "\n", "\n")

  def stage: T[Seq[PathRef]] = Task:
    val jars: Seq[(PathRef, String, String, String, PathRef, PathRef)] =
      Task.traverse(modules)(module =>
        Task.Anon((module.jar(), module.pomSettings().organization, module.artifactId(),
                   module.publishVersion(), module.pom(), module.ivy())))()

    jars.flatMap: (jar, group, artifactId, version, pom, ivy) =>
      val target = Task.dest / s"$artifactId-$version.jar"
      val prefix = s"META-INF/maven/$group/$artifactId"
      val descriptors = Seq(s"$prefix/pom.xml" -> pom.path, s"$prefix/ivy.xml" -> ivy.path)
      withDescriptors(jar.path, target, descriptors)
      val metadata = Task.dest / s"$artifactId-$version.ivy.xml"
      os.write.over(metadata, stripDescriptor(os.read(ivy.path)))
      Seq(PathRef(target), PathRef(metadata))
